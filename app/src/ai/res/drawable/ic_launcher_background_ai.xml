<?xml version="1.0" encoding="utf-8"?>
<!--
  A shape drawable rather than a vector gradient: inline aapt:attr gradients
  only inflate from API 24, and this icon is also drawn as a raster for
  everything older.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#171A45"
        android:centerColor="#35309C"
        android:endColor="#5A3ED1" />
</shape>
